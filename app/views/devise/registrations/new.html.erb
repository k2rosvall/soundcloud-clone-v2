<div class="flex min-h-full flex-col justify-center px-6 py-12 lg:px-8">
  <div class="sm:mx-auto sm:w-full sm:max-w-sm">
    <img src="https://tailwindcss.com/plus-assets/img/logos/mark.svg?color=indigo&shade=500" alt="Your Company" class="mx-auto h-10 w-auto" />
    <h2 class="mt-10 text-center text-2xl/9 font-bold tracking-tight text-black">Sign up</h2>
  </div>
  <div class="mt-10 sm:mx-auto sm:w-full sm:max-w-sm">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |form| %>
      <div class="flex flex-col items-center gap-4 mt-4">
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="field">
          <%= form.label :email, class: "block text-sm/6 font-medium" %>
          <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "block w-full rounded-md bg-white/5 px-3 py-1.5 text-base text-black outline-1 -outline-offset-1 outline-black/10 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-500 sm:text-sm/6" %>
        </div>

        <%= form.fields_for :profile do |g| %>
          <div class="field">
            <%= g.label :username, class: "block text-sm/6 font-medium" %>
            <%= g.text_field :username, class: "block w-full rounded-md bg-white/5 px-3 py-1.5 text-base text-black outline-1 -outline-offset-1 outline-black/10 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-500 sm:text-sm/6" %>
          </div>
        <% end %>
        
        <div class="field">
          <%= form.label :password, class: "block text-sm/6 font-medium" %>
          <% if @minimum_password_length %>
          <em>(<%= @minimum_password_length %> characters minimum)</em>
          <% end %>
          <%= form.password_field :password, autocomplete: "new-password", class: "block w-full rounded-md bg-white/5 px-3 py-1.5 text-base text-black outline-1 -outline-offset-1 outline-black/10 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-500 sm:text-sm/6" %>
        </div>

        <div class="field">
          <%= form.label :password_confirmation, class: "block text-sm/6 font-medium" %>
          <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "block w-full rounded-md bg-white/5 px-3 py-1.5 text-base text-black outline-1 -outline-offset-1 outline-black/10 placeholder:text-gray-500 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-500 sm:text-sm/6" %>
        </div>

        <div>
          <%= form.submit "Sign up", class:"flex w-full justify-center rounded-md bg-indigo-500 px-3 py-1.5 text-sm/6 font-semibold text-white hover:bg-indigo-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
