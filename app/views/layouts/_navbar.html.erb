<nav class="bg-gray-800/50">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between">
      <div class="flex items-center">
        <div class="shrink-0">
          <img src="https://tailwindcss.com/plus-assets/img/logos/mark.svg?color=indigo&shade=500" alt="Your Company" class="size-8" />
        </div>
			  <% if user_signed_in? %>
            <div class="hidden md:block">
              <div class="ml-10 flex items-baseline space-x-4">
                <!-- Current: "bg-gray-950/50 text-white", Default: "text-gray-300 hover:bg-white/5 hover:text-white" -->
                <%= link_to 'Upload', new_profile_track_path(current_user.profile.id), class: "rounded-md bg-gray-950/50 px-3 py-2 text-sm font-medium text-white" %>
                <%= link_to 'Profile', profile_path(current_user.profile.id), class: "rounded-md bg-gray-950/50 px-3 py-2 text-sm font-medium text-white" %>
                <%= link_to 'Sign out', destroy_user_session_path, data: {turbo_method: :delete}, class: "rounded-md bg-gray-950/50 px-3 py-2 text-sm font-medium text-white" %>
              </div>
            </div>
        <% else %>
            <div class="hidden md:block">
              <div class="ml-4 flex items-center md:ml-6">
                <%= link_to 'Register', new_user_registration_path, class: "rounded-md bg-gray-950/50 px-3 py-2 text-sm font-medium text-white" %>
                <%= link_to 'Sign in', new_user_session_path, class: "rounded-md bg-gray-950/50 px-3 py-2 text-sm font-medium text-white" %>
              </div>
            </div>
        <% end %>
      </div>
    </div>
  </div>
</nav>